# pgOS custom package — adapted from the AUR PKGBUILD by Haden Collins
# (wlogout was removed from the official Arch repos; pgOS ships it.)
# NOTE: upstream GPG sig verification dropped for container friendliness.
#       Re-enable validpgpkeys + the .sig source before public release.
pkgname='pgos-wlogout'
pkgver=1.2.2
pkgrel=1
pkgdesc="Logout menu for wayland"
arch=('x86_64')
license=("MIT")
url="https://github.com/ArtsyMacaw/wlogout"
source=("wlogout-${pkgver}.tar.gz::https://github.com/ArtsyMacaw/wlogout/releases/download/${pkgver}/wlogout.tar.gz")
makedepends=("meson" "git" "scdoc")
depends=("gtk3" "gobject-introspection" "gtk-layer-shell")
build() {
    cd $srcdir
    meson setup build --prefix /usr
    ninja -C build
}

package() {
    DESTDIR="$pkgdir" ninja -C build install
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
md5sums=('2d129a847cdf9aa212b834f690f86e4a')
